<header class="panel-topbar">
    <div class="panel-topbar-start">
        <button type="button" class="panel-sidebar-toggle" id="sidebar-toggle" aria-controls="panel-sidebar" aria-expanded="true" aria-label="Recolher menu" title="Recolher menu">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16M4 12h16M4 19h16"/></svg>
        </button>
        <div class="panel-location" aria-label="Localização atual"><span>Área de trabalho</span><span aria-hidden="true">/</span><strong>{{ title|default('Painel')|e }}</strong></div>
    </div>
    <div class="panel-topbar-actions">
        <div class="panel-user" aria-label="Usuário atual">
            <span class="panel-avatar" aria-hidden="true">{{ usuario_nome|default('Usuário')|slice(0, 1)|upper|e }}</span>
            <span class="panel-user-copy"><strong>{{ usuario_nome|default('Usuário')|e }}</strong><small>{{ grupo_nome|default('Grupo não identificado')|e }}</small></span>
        </div>
        <form action="{{ site_url('sair') }}" method="post">
            {{ csrf_field() }}
            <button type="submit" class="panel-logout" aria-label="Sair da conta">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 17l5-5-5-5M15 12H3"/><path d="M12 3h6a3 3 0 0 1 3 3v12a3 3 0 0 1-3 3h-6"/></svg>
                Sair
            </button>
        </form>
    </div>
</header>
